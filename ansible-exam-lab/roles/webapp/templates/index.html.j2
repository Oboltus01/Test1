<!DOCTYPE html>
<html>
<head>
  <title>{{ app_title }}</title>
</head>
<body>
  <h1>{{ app_title }}</h1>
  <p>Host: {{ ansible_hostname }}</p>
  <p>IP address: {{ ansible_default_ipv4.address }}</p>

  <h2>Active webservers</h2>
  <ul>
{% for host in groups['webservers'] %}
    <li>{{ host }}</li>
{% endfor %}
  </ul>
</body>
</html>
